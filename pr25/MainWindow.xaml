<Window x:Class="pr25.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr25"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">
    <Grid Margin="0,0,0,-6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="971*"/>
        </Grid.ColumnDefinitions>
        <TabControl Grid.Column="3">
            <TabItem Header="Task1">
                <Grid Background="#FFE5E5E5" Margin="-23,0,23,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27*"/>
                        <ColumnDefinition Width="71*"/>
                        <ColumnDefinition Width="877*"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="label1" Grid.Column="1" Content="1. Проверить истинность высказывания: &quot;Данное целое положительное число является четным трехзначным числом&quot;." HorizontalAlignment="Left" Margin="0,22,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="textBox1" Grid.Column="1" HorizontalAlignment="Left" Margin="10,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="168" Height="29" Grid.ColumnSpan="2"/>
                    <Button Grid.Column="1" Content="Check" HorizontalAlignment="Left" Margin="10,139,0,0" VerticalAlignment="Top" Height="41" Width="95" Click="Button_Click" Grid.ColumnSpan="2"/>
                    <Label x:Name="label2" Grid.Column="1" Content="Label" HorizontalAlignment="Left" Margin="10,223,0,0" VerticalAlignment="Top" Height="27" Width="648" Grid.ColumnSpan="2"/>
                </Grid>
            </TabItem>
            <TabItem Header="Task2">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="315*"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="label3" Content="2. Задано целое положительное четырехзначное число N (N &gt; 0). Найти разницу между суммой всех его цифр и произведением нечетных цифр." HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
                    <TextBox x:Name="textBox2" HorizontalAlignment="Left" Margin="10,54,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Grid.ColumnSpan="3"/>
                    <Button Content="Check" HorizontalAlignment="Left" Margin="10,105,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.888,-0.347" Height="38" Width="60" Grid.ColumnSpan="3" Click="Button_Click_1"/>
                    <Label x:Name="label4" Content="Label" HorizontalAlignment="Left" Margin="10,181,0,0" VerticalAlignment="Top" Width="503" Grid.ColumnSpan="3"/>
                </Grid>
            </TabItem>
            <TabItem HorizontalAlignment="Center" Height="20" Header="Task3" VerticalAlignment="Center" Width="54">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="19*"/>
                        <ColumnDefinition Width="306*"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="label5" Content="4. Написать функцию bool IsSquare(K) логического типа, возвращающую True, если целый параметр K (K &gt; 0) является квадратом некоторого целого числа, &#xD;&#xA;и False в противном случае." HorizontalAlignment="Left" Margin="10,20,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="textBox3" HorizontalAlignment="Left" Margin="10,75,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Grid.ColumnSpan="2"/>
                    <Button Content="Check" HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.046,0.353" Height="35" Width="102" Grid.ColumnSpan="2" Click="Button_Click_2"/>
                    <Label x:Name="label6" Content="Label" HorizontalAlignment="Left" Margin="10,199,0,0" VerticalAlignment="Top" Width="142" Grid.ColumnSpan="2"/>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
